# Copy to runner/.env and fill in. This file is gitignored; the service-role
# key must never be committed or sent anywhere but Supabase.

# Supabase project URL (Project Settings -> API). Bare URL, no /rest/v1.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Supabase secret key. Newer dashboards: Project Settings -> API Keys ->
# "Secret keys" (starts with sb_secret_). Older dashboards call it the
# service_role key (Legacy API Keys tab, a long eyJ... token). Either works.
# It bypasses row-level security; that is why it lives only on this machine.
SUPABASE_SERVICE_ROLE_KEY=""

# Path to the real Claude Code binary (not the shell function wrapper).
# Check with: type claude
CLAUDE_BIN="$HOME/.local/bin/claude"

# Model alias for the runs: opus | sonnet | haiku
CLAUDE_MODEL="sonnet"

# Seconds between polls when the queue is empty.
POLL_INTERVAL="15"

# A running job whose last progress update is older than this is handed to
# another runner (or retried) on the next claim.
STALE_MINUTES="30"

# Approximate characters per chunk in the summarise map phase.
CHUNK_CHARS="120000"

# Git remote and base branch for result pull requests.
GIT_REMOTE="origin"
BASE_BRANCH="main"

# Book pipeline (convert, chunk, extract with the local model, merge, draft,
# enrich). The folder holding the source PDFs named in
# scripts/convert/manifests/*.json, the pdfdown command, extra pdfdown options,
# and the local llama-server the extraction and merge stages talk to.
BOOKS_DIR="$HOME/Projects/islamic_history_timeline_web_app/books"
PDFDOWN_BIN="uv run --project $HOME/Projects/pdfdown pdfdown"
PDFDOWN_ARGS="--ocr off"
LOCAL_MODEL_URL="http://localhost:8080"
