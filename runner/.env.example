# Copy to runner/.env and fill in. This file is gitignored; the service-role
# key must never be committed or sent anywhere but Supabase.

# Supabase project URL (Project Settings -> API). Bare URL, no /rest/v1.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Service-role key (Project Settings -> API -> service_role). Bypasses
# row-level security; that is why it lives only on the runner machine.
SUPABASE_SERVICE_ROLE_KEY=""

# Path to the real Claude Code binary (not the shell function wrapper).
# Check with: type claude
CLAUDE_BIN="$HOME/.local/bin/claude"

# Model alias for the runs: opus | sonnet | haiku
CLAUDE_MODEL="sonnet"

# Seconds between polls when the queue is empty.
POLL_INTERVAL="15"

# A running job whose last progress update is older than this is handed to
# another runner (or retried) on the next claim.
STALE_MINUTES="30"

# Approximate characters per chunk in the summarise map phase.
CHUNK_CHARS="120000"

# Git remote and base branch for result pull requests.
GIT_REMOTE="origin"
BASE_BRANCH="main"
